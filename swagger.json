            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Customer Orders"
        ],
        "description": "Creates a customer order. If there is enough finished-goods stock it is reserved (status \"ready\"); otherwise a production order is created automatically (status \"in-production\").",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "orderNumber": {
                  "type": "string",
                  "example": "CO-2026-001"
                },
                "customerName": {
                  "type": "string",
                  "example": "Acme Retail"
                },
                "customerEmail": {
                  "type": "string",
                  "example": "orders@acmeretail.com"
                },
                "productId": {
                  "type": "string",
                  "example": "66f5a1b2c3d4e5f6a7b8c901"
                },
                "quantity": {
                  "type": "number",
                  "example": 20
                },
                "dueDate": {
                  "type": "string",
                  "example": "2026-10-15"
                },
                "notes": {
                  "type": "string",
                  "example": "These parts are rework sample pieces"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
